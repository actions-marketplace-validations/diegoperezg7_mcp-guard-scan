{
  "name": "mcp-guard-scan",
  "version": "1.1.0",
  "mcpName": "io.github.diegoperezg7/mcp-guard-scan",
  "description": "Security scanner for MCP servers, as a CLI, a GitHub Action and an MCP server: tool poisoning, shadowing, excessive permissions, leaked secrets and transport flaws, with SARIF output for CI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-guard": "dist/cli/index.js",
    "mcp-guard-scan": "dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "!dist/action",
    "!dist/examples",
    "docs/rules.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "build:action": "tsup --config tsup.action.config.ts && node scripts/third-party-licenses.mjs",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "tsup",
    "docs:rules": "tsx src/cli/index.ts rules --format markdown > docs/rules.md",
    "docs:screenshots": "node docs/screenshots.mjs",
    "version": "node scripts/sync-version.mjs && git add server.json src/shared/version.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/cli/index.js serve"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "appsec",
    "sarif",
    "tool-poisoning",
    "prompt-injection",
    "scanner",
    "ci",
    "mcp-server",
    "mcp-security",
    "ai-security",
    "github-action"
  ],
  "author": "Diego Pérez",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoperezg7/mcp-guard-scan.git"
  },
  "homepage": "https://github.com/diegoperezg7/mcp-guard-scan#readme",
  "bugs": {
    "url": "https://github.com/diegoperezg7/mcp-guard-scan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
